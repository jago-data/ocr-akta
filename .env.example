# OCR Akta — copy to .env. Every variable here is read by the code.

# OCR: mock = dummy records (no network) | live = internal OCR API
AKTA_OCR_MODE=live
AKTA_OCR_API_URL=
AKTA_OCR_API_KEY=
AKTA_OCR_API_KEY_HEADER=X-Api-Token
AKTA_OCR_CHANNEL_ID=
AKTA_OCR_CIF=
AKTA_OCR_REFERENCE_PREFIX=AKTA-
AKTA_OCR_TIMEOUT_S=600
AKTA_OCR_CANCEL_URL=
AKTA_OCR_CANCEL_TIMEOUT_S=10
AKTA_OCR_CONCURRENCY=8
AKTA_OCR_RETRIES=3

# Server
AKTA_HOST=0.0.0.0

# Jobs
AKTA_SHARED_HISTORY=0
AKTA_MAX_ACTIVE_PER_USER=10
AKTA_CONCURRENT_PER_USER=2
AKTA_MAX_CONCURRENT_UPLOADS=40
AKTA_SHUTDOWN_GRACE_S=30
AKTA_MAX_UPLOAD_MB=30
AKTA_JOBS_KEEP=2000
AKTA_MAX_DASHBOARD_EVENTS=200000

# Sessions (admin dashboard token)
AKTA_SESSION_SECRET=
AKTA_SESSION_TTL_HOURS=12

# Branding
AKTA_APP_NAME="OCR Akta"
AKTA_APP_TAGLINE="Ekstraksi Akta Pendirian PT"
AKTA_HELPDESK_EMAIL=

# Deploy (deploy/baremetal)
BE_PORT=8300
FE_PORT=8080
FE_BIND=0.0.0.0
BACKEND_ORIGIN=http://127.0.0.1:8300
SSL_CERT_FILE=
